{
  "name": "arc",
  "version": "1.0.0",
  "description": "Arc browser MCP server (macOS only) — list spaces and tabs, focus a space, open a URL. Read-only: write tools stay off.",
  "author": {
    "name": "mikhail_chepkin",
    "url": "https://github.com/mishachepi"
  },
  "repository": "https://github.com/mishachepi/arc-mcp",
  "keywords": [
    "mcp",
    "arc",
    "browser",
    "macos"
  ],
  "mcpServers": {
    "arc": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/mishachepi/arc-mcp", "arc-mcp"]
    }
  }
}
